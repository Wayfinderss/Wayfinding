FROM ghcr.io/gis-ops/docker-valhalla/valhalla:latest

USER root

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        osmium-tool \
        gdal-bin \
        libgdal-dev \
        python3-gdal \
    && rm -rf /var/lib/apt/lists/*

COPY . /app

RUN pip install uv --break-system-packages

# Pin to system python3 so uv doesn't download its own CPython.
# --system-site-packages makes python3-gdal (from apt) visible inside the venv.
# We never ask pip to install `gdal` — the apt package already provides it.
# ogr2osm is installed with --no-deps to avoid pulling in its `gdal` dependency,
# but its other deps (lxml, packaging) are installed explicitly first.
RUN uv venv /opt/venv --python $(which python3) --system-site-packages \
    && uv pip install --python /opt/venv/bin/python \
        -r requirements.txt \
        lxml \
        packaging \
    && uv pip install --python /opt/venv/bin/python \
        --no-deps ./ogr2osm

ENV PATH="/opt/venv/bin:${PATH}"
ENV PYTHONPATH=/app

COPY scripts/bootstrap_tiles.sh /bootstrap_tiles.sh
RUN chmod +x /bootstrap_tiles.sh

ENTRYPOINT []

EXPOSE 8002

CMD ["/bootstrap_tiles.sh"]